{
  "name": "productivity-server",
  "version": "1.0.0",
  "description": "TypeScript Express.js server for productivity tracking - Ready for Replit deployment",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "watch": "tsc -w",
    "serve": "npm run build && npm start",
    "postinstall": "npm run build"
  },
  "keywords": ["express", "typescript", "productivity", "api", "replit"],
  "author": "Avero Advisors",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "dotenv": "^16.3.1",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  }
}